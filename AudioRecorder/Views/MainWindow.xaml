<Window x:Class="AudioRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Height="850"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{DynamicResource MainTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="UI:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="Gray" />
                <ComboBox Name="UiLanguageComboBox"
                          Height="25"
                          Width="60"
                          SelectionChanged="UILanguage_OnSelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Side - Settings -->
            <Border Grid.Column="0" BorderBrush="#EEE" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MicLabel}" FontWeight="Bold" Margin="0,0,0,5" />
                        <ComboBox Name="MicDeviceComboBox"
                                  Height="25"
                                  Margin="0,0,0,15"
                                  SelectionChanged="MicDeviceComboBox_SelectionChanged" />

                        <TextBlock Text="{DynamicResource SysLabel}" FontWeight="Bold" Margin="0,0,0,5" />
                        <ComboBox Name="SysDeviceComboBox"
                                  Height="25"
                                  Margin="0,0,0,15"
                                  SelectionChanged="SysDeviceComboBox_SelectionChanged" />

                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10"
                                Background="White" Margin="0,10,0,20">
                            <StackPanel Margin="0,-20,0,5">
                                <CheckBox Name="Transcript"
                                          VerticalAlignment="Bottom"
                                          FontWeight="Bold"
                                          Checked="Transcript_OnChecked"
                                          Unchecked="Transcript_OnUnchecked">
                                    <CheckBox.Content>
                                        <TextBlock Text="{DynamicResource EnableTranscriptionLabel}" Background="White" />
                                    </CheckBox.Content>
                                </CheckBox>

                                <Grid Margin="5,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource WhisperModelLabel}" FontWeight="Bold"
                                                   Margin="0,0,0,5" />
                                        <ComboBox Name="WhisperModelComboBox"
                                                  Height="25"
                                                  SelectionChanged="WhisperModelComboBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource TranscriptionLanguageLabel}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5" />
                                        <ComboBox Name="TranscriptLanguageComboBox" Height="25"
                                                  SelectionChanged="TranscriptLanguage_OnSelectionChanged" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="5,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource RuntimeLibraryOrderLabel}" FontWeight="Bold"
                                                   Margin="0,0,0,5" />
                                        <ListBox Name="RuntimeLibrariesListBox" Height="100" DisplayMemberPath="." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Name="MoveUpButton" Content="{DynamicResource MoveUp}"
                                                Click="MoveUpButton_Click"
                                                Margin="0,0,0,5" Width="60" />
                                        <Button Name="MoveDownButton" Content="{DynamicResource MoveDown}"
                                                Click="MoveDownButton_Click"
                                                Width="60" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Control Buttons -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Name="StartButton"
                                    Content="{DynamicResource StartButton}"
                                    Height="45"
                                    Margin="0,0,5,0"
                                    Click="StartButton_Click"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    FontWeight="Bold" />

                            <Button Name="StopButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource StopButton}"
                                    Height="45"
                                    Margin="5,0,0,0"
                                    Click="StopButton_Click"
                                    IsEnabled="False"
                                    Background="#f44336"
                                    Foreground="White"
                                    FontWeight="Bold" />
                        </Grid>

                        <Button Name="SaveButton"
                                Content="{DynamicResource SaveButton}"
                                Height="45"
                                Click="SaveButton_Click"
                                IsEnabled="False"
                                Background="#2196F3"
                                Foreground="White"
                                FontWeight="Bold" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 1: Right Side - Status and Transcriptions -->
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Status Border -->
                    <RowDefinition Height="*" />    <!-- Transcriptions -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Padding="15"
                        Background="#F9F9F9"
                        Margin="0,0,0,15"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBox Name="StatusLabel"
                                 Text="{DynamicResource ReadyStatus}"
                                 FontSize="13"
                                 Foreground="#333"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,15"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 IsTabStop="False" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource MicLevelLabel}" FontSize="11" Margin="0,0,0,5" />
                                <ProgressBar Name="MicLevelBar" Height="14" Minimum="0" Maximum="1" Value="0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource SysLevelLabel}" FontSize="11" Margin="0,0,0,5" />
                                <ProgressBar Name="SysLevelBar" Height="14" Minimum="0" Maximum="1" Value="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource MicTranscriptionLabel}" FontWeight="Bold"
                               FontSize="11"
                               Margin="0,5,0,5" />
                    <TextBox Grid.Row="1" Name="MicTranscriptionTextBox"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Background="White"
                             Margin="0,0,0,15" />

                    <TextBlock Grid.Row="2" Text="{DynamicResource SysTranscriptionLabel}" FontWeight="Bold"
                               FontSize="11"
                               Margin="0,5,0,5" />
                    <TextBox Grid.Row="3" Name="SysTranscriptionTextBox"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Background="White" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 2: Footer - Instructions -->
        <Border Grid.Row="2" BorderBrush="#EEE" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource InstructionsHeader}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Instruction1}" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{DynamicResource Instruction2}" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,0,0,2" />
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="{DynamicResource Instruction3}" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{DynamicResource Instruction4}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>